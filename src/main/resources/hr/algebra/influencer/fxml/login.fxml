<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" prefWidth="320.0" prefHeight="240.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hr.algebra.influencer.Controller.LoginController">
    <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>

    <Label text="Influencer - Prijava" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="korisnickoImeField" promptText="Korisničko ime" alignment="CENTER"/>
    <PasswordField fx:id="lozinkaField" promptText="Lozinka" alignment="CENTER"/>

    <Button text="Prijava" defaultButton="true" onAction="#handleLogin"/>
</VBox>
