<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="860.0" prefHeight="700.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.influencer.Controller.BrandSuradnjaController">
    <padding><Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/></padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label text="Brand suradnje" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Osvježi" prefWidth="90.0" onAction="#handleOsvjezi"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12.0">
            <BorderPane.margin><Insets top="10.0" bottom="10.0"/></BorderPane.margin>

            <TextField fx:id="pretragaField" promptText="Pretraži kampanje po nazivu..."/>

            <TableView fx:id="tablica" VBox.vgrow="ALWAYS" prefHeight="170.0">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="40.0"/>
                    <TableColumn fx:id="nazivKampanjeColumn" text="Kampanja" prefWidth="150.0"/>
                    <TableColumn fx:id="brandColumn" text="Brand" prefWidth="110.0"/>
                    <TableColumn fx:id="godinaColumn" text="Godina" prefWidth="70.0"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="90.0"/>
                    <TableColumn fx:id="timColumn" text="Tim" prefWidth="200.0"/>
                </columns>
            </TableView>

            <Separator/>

            <Label text="Podaci o kampanji" style="-fx-font-weight: bold;"/>
            <GridPane hgap="8.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="100.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints halignment="RIGHT" minWidth="100.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Naziv kampanje:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nazivKampanjeField" promptText="npr. Ljeto 2026" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Brand:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <ComboBox fx:id="brandComboBox" promptText="odaberi brand" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Godina:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="godinaField" promptText="npr. 2026" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Status:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <ComboBox fx:id="statusComboBox" promptText="odaberi status" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            </GridPane>

            <Separator/>

            <Label text="Tim (povuci influencera iz lijeve u desnu listu)" style="-fx-font-weight: bold;"/>
            <HBox spacing="12.0" VBox.vgrow="ALWAYS">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Dostupni influenceri"/>
                    <ListView fx:id="dostupniListView" VBox.vgrow="ALWAYS" prefHeight="140.0"/>
                </VBox>
                <VBox spacing="6.0" alignment="CENTER">
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button fx:id="ukloniIzTimaButton" text="&lt; Ukloni" onAction="#handleUkloniIzTima"/>
                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Tim kampanje"/>
                    <ListView fx:id="timListView" VBox.vgrow="ALWAYS" prefHeight="140.0"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <BorderPane.margin><Insets top="10.0"/></BorderPane.margin>
            <Button fx:id="novaButton" text="Novo" prefWidth="90.0" onAction="#handleNova"/>
            <Button fx:id="brisiButton" text="Obriši" prefWidth="90.0" onAction="#handleBrisi"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="spremiButton" text="Dodaj" prefWidth="100.0" onAction="#handleSpremi" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>
