<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="360.0" prefHeight="180.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.influencer.Controller.Platforma.PlatformaDodajController">
    <padding><Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/></padding>

    <top>
        <Label text="Nova platforma" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </top>

    <center>
        <VBox spacing="8.0">
            <BorderPane.margin><Insets top="12.0" bottom="12.0"/></BorderPane.margin>

            <Label text="Naziv:"/>
            <TextField fx:id="nazivField" promptText="npr. Instagram"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Button text="Odustani" prefWidth="90.0" onAction="#handleOdustani"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Spremi" prefWidth="90.0" onAction="#handleSpremi" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>
