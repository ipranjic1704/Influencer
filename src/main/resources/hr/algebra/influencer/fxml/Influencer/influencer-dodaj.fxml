<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="420.0" prefHeight="440.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.influencer.Controller.Influencer.InfluencerDodajController">
    <padding><Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/></padding>

    <top>
        <Label text="Novi influencer" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </top>

    <center>
        <VBox spacing="8.0">
            <BorderPane.margin><Insets top="12.0" bottom="12.0"/></BorderPane.margin>

            <Label text="Ime/Nadimak:"/>
            <TextField fx:id="imeNadimakField" promptText="npr. TravelWithMia"/>

            <Label text="Broj pratitelja:"/>
            <TextField fx:id="brojPratiteljaField" promptText="npr. 150000"/>

            <Label text="Engagement rate (%):"/>
            <TextField fx:id="engagementRateField" promptText="npr. 3.5"/>

            <Label text="Zemlja:"/>
            <TextField fx:id="zemljaField" promptText="npr. Hrvatska"/>

            <Label text="Jezik sadržaja:"/>
            <TextField fx:id="jezikSadrzajaField" promptText="npr. Hrvatski"/>

            <Label text="Profilna slika (putanja s diska):"/>
            <TextField fx:id="profilnaSlikaField" promptText="npr. C:\slike\profil.png"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Button text="Odustani" prefWidth="90.0" onAction="#handleOdustani"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Spremi" prefWidth="90.0" onAction="#handleSpremi" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>
