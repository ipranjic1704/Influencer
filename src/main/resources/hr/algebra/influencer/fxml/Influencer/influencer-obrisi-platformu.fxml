<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="400.0" prefHeight="190.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.influencer.Controller.Influencer.InfluencerObrisiPlatformuController">
    <padding><Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/></padding>

    <top>
        <Label fx:id="naslovLabel" text="Ukloni platformu" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </top>

    <center>
        <VBox spacing="8.0">
            <BorderPane.margin><Insets top="12.0" bottom="12.0"/></BorderPane.margin>
            <Label text="Platforma:"/>
            <ComboBox fx:id="platformaComboBox" prefWidth="370.0"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Button text="Odustani" prefWidth="90.0" onAction="#handleOdustani"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Obriši" prefWidth="90.0" onAction="#handleObrisi" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>
