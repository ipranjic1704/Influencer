<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="760.0" prefHeight="480.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.influencer.Controller.Influencer.InfluencerController">
    <padding><Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/></padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label text="Influenceri" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Osvježi" prefWidth="90.0" onAction="#handleOsvjezi"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <BorderPane.margin><Insets top="10.0" bottom="10.0"/></BorderPane.margin>

            <TextField fx:id="pretragaField" promptText="Pretraži influencere po imenu/nadimku..."/>

            <TableView fx:id="tablica" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0"/>
                    <TableColumn fx:id="imeNadimakColumn" text="Ime/Nadimak" prefWidth="180.0"/>
                    <TableColumn fx:id="zemljaColumn" text="Zemlja" prefWidth="120.0"/>
                    <TableColumn fx:id="brojPratiteljaColumn" text="Broj pratitelja" prefWidth="130.0"/>
                    <TableColumn fx:id="engagementRateColumn" text="Engagement (%)" prefWidth="130.0"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Button fx:id="dodajButton" text="Dodaj..." prefWidth="90.0" onAction="#handleDodaj"/>
            <Button fx:id="urediButton" text="Uredi..." prefWidth="90.0" onAction="#handleUredi"/>
            <Button fx:id="dodajPlatformuButton" text="Dodaj platformu..." prefWidth="150.0" onAction="#handleDodajPlatformu"/>
            <Button fx:id="obrisiPlatformuButton" text="Obriši platformu..." prefWidth="150.0" onAction="#handleObrisiPlatformu"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="brisiButton" text="Obriši" prefWidth="90.0" onAction="#handleBrisi"/>
        </HBox>
    </bottom>
</BorderPane>
