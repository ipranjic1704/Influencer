<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="480.0" prefHeight="460.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.influencer.Controller.TipSadrzajaController">
    <padding><Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/></padding>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label text="Tipovi sadržaja" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Osvježi" prefWidth="90.0" onAction="#handleOsvjezi"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <BorderPane.margin><Insets top="10.0" bottom="10.0"/></BorderPane.margin>

            <TextField fx:id="pretragaField" promptText="Pretraži tipove sadržaja po nazivu..."/>

            <TableView fx:id="tablica" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0"/>
                    <TableColumn fx:id="nazivColumn" text="Naziv" prefWidth="200.0"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="Naziv:"/>
                <TextField fx:id="nazivField" HBox.hgrow="ALWAYS" promptText="npr. Reels"/>
                <Button fx:id="spremiButton" text="Dodaj" prefWidth="90.0" onAction="#handleSpremi" defaultButton="true"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Button fx:id="novaButton" text="Novo" prefWidth="90.0" onAction="#handleNova"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="brisiButton" text="Obriši" prefWidth="90.0" onAction="#handleBrisi"/>
        </HBox>
    </bottom>
</BorderPane>
