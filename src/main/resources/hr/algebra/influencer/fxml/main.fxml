<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane prefHeight="480.0" prefWidth="640.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.influencer.Controller.MainController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <padding><Insets bottom="12.0" left="16.0" right="16.0" top="12.0"/></padding>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Influencer"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="korisnikLabel"/>
            <Button onAction="#handleOdjava" text="Odjava"/>
        </HBox>
    </top>

</BorderPane>
